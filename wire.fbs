namespace wire;

struct Body {
    id:uint;
    x:float;
    y:float;
}

table Input {
    sequence:uint;
    dx:byte;
    dy:byte;
}

table Snapshot {
    tick:ulong;
    ack:uint;
    self:uint;
    bodies:[Body];
}

union Payload { Input, Snapshot }
table Packet { payload:Payload; }
root_type Packet;
file_identifier "SIM1";
